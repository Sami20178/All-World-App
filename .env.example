# Copy this file to .env on the server. Never commit the real .env file.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5500
# In production use a unique random secret (32+ characters), set the exact HTTPS APP_ORIGIN, and never keep this example value.
SESSION_SECRET=replace-with-a-long-random-secret-before-production
# Optional persistent SQLite database path:
# DATABASE_FILE=./data/all-world.sqlite
# Optional folder used for the database and legacy JSON import:
# DATA_DIR=./data

# Production cross-site frontend: none requires HTTPS. Use lax for same-site deployments.
# COOKIE_SAME_SITE=none

# Social login: set API_PUBLIC_URL to the public HTTPS base URL of this API.
# Configure providers in OAUTH_PROVIDERS_JSON (JSON; secrets stay in server environment only).
# Example provider configurations, including PKCE for Roblox and X, are documented in README.md.
# Set "pkce": true for providers that require or recommend PKCE; never put real secrets in source control.
# Apple requires a Services ID, Team ID, Key ID and private key in server-only OAUTH_PROVIDERS_JSON.
# API_PUBLIC_URL=https://api.example.com
# OAUTH_PROVIDERS_JSON={}

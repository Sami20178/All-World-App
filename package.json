{
  "name": "all-world-app-server",
  "version": "0.2.0",
  "private": true,
  "description": "All World Node.js API and authentication server",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "check": "node --check server.js",
    "lint": "node --check server.js",
    "test": "node tests/smoke-test.js",
    "docker:build": "docker build -t all-world-app:latest .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0"
  }
}
